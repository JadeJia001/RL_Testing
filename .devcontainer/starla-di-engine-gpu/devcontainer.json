{
  "name": "RL_Testing GPU (STARLA + DI-engine)",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "../../STARLA"
  },
  "runArgs": ["--gpus", "all", "--ipc=host"],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "workspaceFolder": "/workspaces/RL_Testing",
  "postCreateCommand": "pip install -e './STARLA[dev]' && (pip install --no-cache-dir DI-engine || pip install --no-cache-dir di-engine) && pip install --no-cache-dir ale-py shimmy 'AutoROM[accept-rom-license]' Pillow mujoco 'gymnasium[mujoco]' && AutoROM --accept-license",
  "remoteUser": "vscode"
}
